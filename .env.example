# Copiar a .env y completar. NUNCA subir .env al repositorio.
NODE_ENV=development
PORT=3000
# Cadena de conexión de Neon (incluye ?sslmode=require)
DATABASE_URL=postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Cadena larga y aleatoria: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiar-por-un-valor-aleatorio
# Contraseñas iniciales usadas por el script de seed (opcional)
SEED_ADMIN_PASSWORD=
SEED_PERSONAL_PASSWORD=
