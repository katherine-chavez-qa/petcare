<%- include('../partials/header') %>
<div class="toolbar">
  <h2>Clientes</h2>
  <a href="/clientes/nuevo" role="button">+ Nuevo cliente</a>
</div>
<form method="get" action="/clientes" role="search">
  <input type="search" name="q" value="<%= q %>" placeholder="Buscar por nombre, correo o teléfono">
  <button type="submit">Buscar</button>
</form>
<div class="table-wrap">
<table>
  <thead><tr><th>Nombre</th><th>Teléfono</th><th>Correo</th><th>Mascotas</th><th>Acciones</th></tr></thead>
  <tbody>
  <% if (!clientes.length) { %><tr><td colspan="5">No hay clientes registrados.</td></tr><% } %>
  <% clientes.forEach(function (c) { %>
    <tr>
      <td><%= c.nombre %></td><td><%= c.telefono %></td><td><%= c.correo %></td><td><%= c.mascotas %></td>
      <td class="actions">
        <a role="button" class="secondary" href="/clientes/<%= c.id_cliente %>/editar">Editar</a>
        <form method="post" action="/clientes/<%= c.id_cliente %>/eliminar" onsubmit="return confirm('¿Eliminar este cliente?')">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="contrast outline">Eliminar</button>
        </form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<%- include('../partials/footer') %>
